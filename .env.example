# Placeholders only. Never put a real seed, key or token in this file.
CRIPTON_API_URL=https://api.criptonlabs.com
CRIPTON_TIER=free
CRIPTON_MAX_PER_CALL=
CRIPTON_SESSION_BUDGET=
CRIPTON_XRPL_NETWORK=mainnet
CRIPTON_XRPL_PAYER_SEED=
CRIPTON_XRPL_WS_URL=
CRIPTON_SOLANA_NETWORK=mainnet
CRIPTON_SOLANA_PAYER_KEY=
CRIPTON_SOLANA_PAY_ASSET=USDC
CRIPTON_SOLANA_RPC_URL=
# Prepaid credit token (clc_...); needs CRIPTON_TIER=pro. Shown once by the CLI topup or rotate-token.
CRIPTON_CREDITS_TOKEN=
# Solana only; set both or neither. The XRPL kit ignores them.
# CRIPTON_TOPUP_MAX: per-purchase maximum of the MCP tool solana_credits_topup.
# CRIPTON_TOPUP_BUDGET: cap on the total of the process's Solana top-ups (the tool and the CLI topup).
CRIPTON_TOPUP_MAX=
CRIPTON_TOPUP_BUDGET=
# Solana only: on spends credits with a Sign-In-With-X proof of CRIPTON_SOLANA_PAYER_KEY (tier pro).
CRIPTON_SOLANA_SIWX=off
