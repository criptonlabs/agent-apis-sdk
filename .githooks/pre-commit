#!/bin/sh
# Fails closed: a commit is refused when gitleaks is missing or finds a secret, or when lint or
# typecheck fail (fast checks, ~7 s; tests run in pre-push).
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit (install gitleaks v8.30.1)." >&2
  exit 1
fi
gitleaks git --pre-commit --redact --staged --verbose
pnpm lint
pnpm typecheck
